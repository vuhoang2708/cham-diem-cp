<FormulaPath>Imported\codex_simple_fopen_oneline.afl</FormulaPath>
<FormulaContent>outfile = "C:/Users/Public/ag_simple_fopen_oneline_out.txt";
fh = fopen(outfile, "w");
fh_ok = 0;

if (fh)
{
    fh_ok = 1;
    fputs("symbol=" + Name() + ";close=" + NumToStr(LastValue(Close), 1.4) + ";ready=1", fh);
    fclose(fh);
}

Filter = 1;
AddTextColumn(Name(), "symbol", 1.0);
AddColumn(DateTime(), "dt", formatDateTime);
AddColumn(Close, "close", 1.2);
AddColumn(fh_ok, "fh_ok", 1.0);</FormulaContent>
